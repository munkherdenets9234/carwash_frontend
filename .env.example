# The Go API. Read server-side only — the browser never sees this URL, it
# calls this app's own /api/bff/* routes, which attach the auth token from an
# httpOnly cookie. See src/app/api/bff/[...path]/route.ts.
BACKEND_URL=http://localhost:8091

# The tenant API key, from the platform. Identifies which business this
# storefront belongs to.
#
# Server-side only — never NEXT_PUBLIC_. A key in a NEXT_PUBLIC_ variable is
# inlined into the browser bundle, and for this key that means anyone who
# opens the page can read the business's bookings, staff and day report.
TENANT_API_KEY=
